{
  "$schema": "https://opencode.ai/config.json",
  // Garde-fous d'Allure : les secrets et les données réelles vivent hors du projet.
  // Ce fichier est contrôlé par Lucas. L'agent ne doit pas le modifier lui-même.
  "permissions": [
    // 1. Fichiers d'environnement : lecture et écriture interdites,
    //    sauf le modèle public .env.example (valeurs factices uniquement).
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.env.*", "effect": "deny" },
    { "action": "edit", "resource": "*.env.example", "effect": "allow" },

    // 2. Dossier privé hors projet : aucun accès, même indirect.
    { "action": "external_directory", "resource": "$HOME/Desktop/Allure-prive/*", "effect": "deny" },
    { "action": "read", "resource": "$HOME/Desktop/Allure-prive/*", "effect": "deny" },
    { "action": "edit", "resource": "$HOME/Desktop/Allure-prive/*", "effect": "deny" },

    // 3. Fichiers d'activité bruts : données personnelles, jamais lues par l'agent.
    { "action": "read", "resource": "*.fit", "effect": "deny" },
    { "action": "read", "resource": "*.gpx", "effect": "deny" },
    { "action": "edit", "resource": "*.fit", "effect": "deny" },
    { "action": "edit", "resource": "*.gpx", "effect": "deny" },

    // 4. Empêcher l'agent de désactiver ses propres garde-fous.
    { "action": "edit", "resource": "opencode.jsonc", "effect": "deny" },
    { "action": "shell", "resource": "*opencode.jsonc*", "effect": "deny" },

    // 5. Commandes qui pourraient afficher ou copier des secrets.
    { "action": "shell", "resource": "*Allure-prive*", "effect": "deny" },
    { "action": "shell", "resource": "printenv*", "effect": "deny" },
    { "action": "shell", "resource": "env", "effect": "deny" },
    { "action": "shell", "resource": "Get-ChildItem Env:*", "effect": "deny" },
    { "action": "shell", "resource": "Get-ChildItem env:*", "effect": "deny" },
    { "action": "shell", "resource": "*$env:*", "effect": "deny" },
    { "action": "shell", "resource": "*Get-Content*.env*", "effect": "deny" },
    { "action": "shell", "resource": "*cat *.env*", "effect": "deny" },
    { "action": "shell", "resource": "*Set-Content*.env*", "effect": "deny" }
  ]
}
