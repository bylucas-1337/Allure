# Modèle à copier HORS du projet, par exemple vers :
#   C:\Users\lucas\Desktop\Allure-prive\.env
# Puis indiquer ce chemin dans la variable système ALLURE_ENV_FILE.
#
# Ce fichier reste dans le projet et ne doit contenir que des valeurs factices.
# Ne mets jamais de vraie clé ici.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Clé publique. Supabase l'appelle « anon public » (ancien nom)
# ou « publishable key » (nouveau nom). Une seule des deux lignes suffit.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
